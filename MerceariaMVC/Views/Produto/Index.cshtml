@model IEnumerable<MerceariaMVC.Models.Produto>

@{
    ViewData["Title"] = "Produtos";

    var totalProdutos =
        Model?.Count() ?? 0;

    var semEstoque =
        Model?.Count(x => x.Estoque == 0) ?? 0;

    var estoqueBaixo =
        Model?.Count(
            x => x.Estoque > 0 &&
                 x.Estoque <= 5
        ) ?? 0;
}

<div class="screen product-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Estoque
            </span>

            <h1>Produtos</h1>

            <p>
                Pesquise produtos, acompanhe quantidades
                e identifique rapidamente o nível de estoque.
            </p>

        </div>


        <a asp-action="Create"
           class="ui-btn ui-btn-amber">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <path d="M12 5v14M5 12h14" />

            </svg>

            Novo produto

        </a>

    </div>


    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />

                    <path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />

                </svg>

            </div>

            <div>
                <small>Total de produtos</small>
                <strong>@totalProdutos</strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M12 9v4M12 17h.01" />
                    <circle cx="12" cy="12" r="9" />

                </svg>

            </div>

            <div>
                <small>Estoque baixo</small>
                <strong>@estoqueBaixo</strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M8 8l8 8M16 8l-8 8" />
                    <circle cx="12" cy="12" r="9" />

                </svg>

            </div>

            <div>
                <small>Sem estoque</small>
                <strong>@semEstoque</strong>
            </div>

        </div>

    </div>


    <section class="data-panel">

        <div class="data-toolbar">

            <div class="toolbar-group">

                <div class="search-box">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="11"
                                cy="11"
                                r="7" />

                        <path d="m20 20-3.6-3.6" />

                    </svg>


                    <input id="produtoBusca"
                           type="search"
                           placeholder="Pesquisar produto..."
                           autocomplete="off" />

                </div>


                <select id="produtoFiltro"
                        class="toolbar-select">

                    <option value="todos">
                        Todos os estoques
                    </option>

                    <option value="disponivel">
                        Disponível
                    </option>

                    <option value="baixo">
                        Estoque baixo
                    </option>

                    <option value="zerado">
                        Sem estoque
                    </option>

                </select>

            </div>


            <span id="produtoResultado"
                  class="result-count">

                @totalProdutos registro(s)

            </span>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="modern-table"
                       id="produtosTabela">

                    <thead>

                        <tr>
                            <th>Produto</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var estoqueStatus =
                            item.Estoque == 0
                            ? "zerado"
                            : item.Estoque <= 5
                            ? "baixo"
                            : "disponivel";


                            <tr class="produto-row"
                                data-search="@(item.Nome?.ToLowerInvariant() ?? "")"
                                data-status="@estoqueStatus">

                                <td class="entity-mobile"
                                    data-label="Produto">

                                    <div class="entity-cell">

                                        <span class="entity-avatar">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />

                                                <path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />

                                            </svg>

                                        </span>

                                        <div>

                                            <strong>
                                                @item.Nome
                                            </strong>

                                            <small>
                                                Produto #@item.IdProduto
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td data-label="Preço">

                                    <span class="price-value">

                                        @item.Preco.ToString(
                                        "C",
                                                                new System.Globalization.CultureInfo("pt-BR")
                                                                )

                            </span>

                        </td>


                        <td data-label="Estoque">

                            <span class="stock-number">
                                @item.Estoque un.
                            </span>

                        </td>


                        <td data-label="Status">

                            @if (item.Estoque == 0)
                                    {
                                        <span class="status-pill status-danger">
                                            Sem estoque
                                        </span>
                                    }
                                    else if (item.Estoque <= 5)
                                    {
                                        <span class="status-pill status-warning">
                                            Estoque baixo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-ok">
                                            Disponível
                                        </span>
                                    }

                                </td>


                                <td data-label="Ações">

                                    <div class="row-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdProduto"
                                           class="row-action"
                                           title="Detalhes">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <circle cx="12"
                                                        cy="12"
                                                        r="3" />

                                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" />

                                            </svg>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdProduto"
                                           class="row-action"
                                           title="Editar">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M12 20h9" />

                                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />

                                            </svg>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdProduto"
                                           class="row-action delete"
                                           title="Excluir">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" />

                                                <path d="M10 11v5M14 11v5" />

                                            </svg>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div id="produtoSemResultado"
                 class="filter-empty-state">

                <h3>
                    Nenhum produto encontrado
                </h3>

                <p>
                    Tente outro nome ou altere
                    o filtro de estoque.
                </p>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />

                        <path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />

                    </svg>

                </div>

                <h3>
                    Nenhum produto cadastrado
                </h3>

                <p>
                    Cadastre o primeiro produto
                    para começar a controlar seu estoque.
                </p>

                <a asp-action="Create"
                   class="ui-btn ui-btn-amber">

                    Cadastrar produto

                </a>

            </div>
        }

    </section>

</div>


@section Scripts {

    <script>

        (() => {

            const busca =
                document.getElementById('produtoBusca');

            const filtro =
                document.getElementById('produtoFiltro');

            const rows =
                [...document.querySelectorAll('.produto-row')];

            const contador =
                document.getElementById('produtoResultado');

            const vazio =
                document.getElementById('produtoSemResultado');

            const tabela =
                document.getElementById('produtosTabela');


            if (!busca || !filtro || !rows.length)
                return;


            const aplicar = () => {

                const termo =
                    busca.value.trim().toLowerCase();

                const status =
                    filtro.value;

                let visiveis = 0;


                rows.forEach(row => {

                    const combinaBusca =
                        !termo ||
                        row.dataset.search.includes(termo);

                    const combinaStatus =
                        status === 'todos' ||
                        row.dataset.status === status;

                    const mostrar =
                        combinaBusca && combinaStatus;


                    row.style.display =
                        mostrar ? '' : 'none';


                    if (mostrar)
                        visiveis++;

                });


                contador.textContent =
                    `${visiveis} registro(s)`;


                vazio.style.display =
                    visiveis === 0
                        ? 'block'
                        : 'none';


                tabela.style.display =
                    visiveis === 0
                        ? 'none'
                        : 'table';

            };


            busca.addEventListener(
                'input',
                aplicar
            );


            filtro.addEventListener(
                'change',
                aplicar
            );

        })();

    </script>

}