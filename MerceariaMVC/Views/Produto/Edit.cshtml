@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Editar produto";
}

<div class="screen product-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Produtos
            </span>

            <h1>Editar produto</h1>

            <p>
                Atualize os dados de
                <strong>@Model.Nome</strong>.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para produtos

        </a>

    </div>


    <div class="form-layout">

        <aside class="form-aside">

            <div class="aside-accent"></div>

            <div class="aside-body">

                <div class="aside-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M12 20h9" />

                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />

                    </svg>

                </div>

                <h3>
                    Atualização de produto
                </h3>

                <p>
                    Altere nome, preço ou estoque
                    e salve os novos dados.
                </p>


                <div class="aside-tips">

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            Confira o preço antes de confirmar.
                        </span>

                    </div>

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            O status de estoque é calculado
                            pela quantidade.
                        </span>

                    </div>

                </div>

            </div>

        </aside>


        <section class="form-panel">

            <div class="form-panel-header">

                <h2>Dados atuais</h2>

                <p>
                    Edite os campos necessários.
                </p>

            </div>


            <div class="form-panel-body">

                <form asp-action="Edit">

                    <input type="hidden"
                           asp-for="IdProduto" />


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="form-grid">

                        <div class="field-group form-span-2">

                            <label asp-for="Nome">
                                Nome do produto
                            </label>

                            <input asp-for="Nome"
                                   class="form-control" />

                            <span asp-validation-for="Nome"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group">

                            <label asp-for="Preco">
                                Preço
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    R$
                                </span>

                                <input asp-for="Preco"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="Preco"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group">

                            <label asp-for="Estoque">
                                Quantidade em estoque
                            </label>

                            <input asp-for="Estoque"
                                   class="form-control"
                                   min="0" />

                            <span asp-validation-for="Estoque"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <div class="form-actions">

                        <a asp-action="Index"
                           class="ui-btn ui-btn-light">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="ui-btn ui-btn-amber">

                            Salvar alterações

                        </button>

                    </div>

                </form>

            </div>

        </section>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}