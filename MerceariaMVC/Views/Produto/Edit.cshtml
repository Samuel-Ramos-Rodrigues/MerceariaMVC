@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Editar produto";
}

<div class="py-4">
    <div class="mb-4">
        <div class="small text-muted mb-1">Produtos</div>
        <h1 class="h3 mb-1">Editar produto</h1>
        <p class="text-muted mb-0">Atualize as informações do produto selecionado.</p>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 px-4">
                    <span class="fw-semibold">Dados do produto</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="IdProduto" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Nome" class="form-label fw-semibold"></label>
                                <input asp-for="Nome" class="form-control" />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Preco" class="form-label fw-semibold">Preço</label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Preco" class="form-control" />
                                </div>
                                <span asp-validation-for="Preco" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Estoque" class="form-label fw-semibold"></label>
                                <input asp-for="Estoque" class="form-control" />
                                <span asp-validation-for="Estoque" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-success">Salvar alterações</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
