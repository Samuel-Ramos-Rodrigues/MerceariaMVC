@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Novo produto";
}

<div class="screen product-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Produtos
            </span>

            <h1>Novo produto</h1>

            <p>
                Cadastre um item e defina
                seu preço e quantidade em estoque.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para produtos

        </a>

    </div>


    <div class="form-layout">

        <aside class="form-aside">

            <div class="aside-accent"></div>

            <div class="aside-body">

                <div class="aside-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />

                        <path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />

                    </svg>

                </div>

                <h3>
                    Cadastro de produto
                </h3>

                <p>
                    Informe os dados principais
                    para o produto aparecer no estoque.
                </p>


                <div class="aside-tips">

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            Use um nome fácil de identificar.
                        </span>

                    </div>

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            O preço deve ser maior que zero.
                        </span>

                    </div>

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            Informe a quantidade atual em estoque.
                        </span>

                    </div>

                </div>

            </div>

        </aside>


        <section class="form-panel">

            <div class="form-panel-header">

                <h2>Dados do produto</h2>

                <p>
                    Informações usadas no cadastro
                    e no estoque.
                </p>

            </div>


            <div class="form-panel-body">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="form-grid">

                        <div class="field-group form-span-2">

                            <label asp-for="Nome">
                                Nome do produto
                            </label>

                            <input asp-for="Nome"
                                   class="form-control"
                                   placeholder="Ex.: Arroz 1kg" />

                            <span asp-validation-for="Nome"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group">

                            <label asp-for="Preco">
                                Preço
                            </label>


                            <div class="input-group">

                                <span class="input-group-text">
                                    R$
                                </span>

                                <input asp-for="Preco"
                                       class="form-control"
                                       placeholder="0,00" />

                            </div>

                            <span asp-validation-for="Preco"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group">

                            <label asp-for="Estoque">
                                Quantidade em estoque
                            </label>

                            <input asp-for="Estoque"
                                   class="form-control"
                                   placeholder="Ex.: 20"
                                   min="0" />

                            <span asp-validation-for="Estoque"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <div class="form-actions">

                        <a asp-action="Index"
                           class="ui-btn ui-btn-light">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="ui-btn ui-btn-amber">

                            Salvar produto

                        </button>

                    </div>

                </form>

            </div>

        </section>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}