@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Detalhes do produto";
}

<div class="screen product-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Produtos
            </span>

            <h1>
                Detalhes do produto
            </h1>

            <p>
                Consulte preço, quantidade
                e situação atual do estoque.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para produtos

        </a>

    </div>


    <section class="detail-hero">

        <div class="detail-identity">

            <div class="detail-avatar">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />

                    <path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />

                </svg>

            </div>

            <div>

                <h2>
                    @Model.Nome
                </h2>

                <p>
                    Produto #@Model.IdProduto
                </p>

            </div>

        </div>


        <div class="detail-hero-actions">

            @if (Model.Estoque == 0)
            {
                <span class="status-pill status-danger">
                    Sem estoque
                </span>
            }
            else if (Model.Estoque <= 5)
            {
                <span class="status-pill status-warning">
                    Estoque baixo
                </span>
            }
            else
            {
                <span class="status-pill status-ok">
                    Disponível
                </span>
            }


            <a asp-action="Edit"
               asp-route-id="@Model.IdProduto"
               class="ui-btn ui-btn-amber">

                Editar produto

            </a>

        </div>

    </section>


    <section class="detail-panel">

        <div class="detail-panel-header">
            Informações do produto
        </div>


        <div class="detail-grid">

            <div class="detail-field">

                <span class="detail-label">
                    Produto
                </span>

                <span class="detail-value">
                    @Model.Nome
                </span>

            </div>


            <div class="detail-field">

                <span class="detail-label">
                    Preço
                </span>

                <span class="detail-value">

                    @Model.Preco.ToString(
                    "C",
                                        new System.Globalization.CultureInfo("pt-BR")
                                        )

                </span>

            </div>


            <div class="detail-field">

                <span class="detail-label">
                    Estoque
                </span>

                <span class="detail-value">
                    @Model.Estoque unidade(s)
                </span>

            </div>


            <div class="detail-field">

                <span class="detail-label">
                    Situação
                </span>

                <span class="detail-value">

                    @(Model.Estoque == 0
                                        ? "Sem estoque"
                                        : Model.Estoque <= 5
                                        ? "Estoque baixo"
                                        : "Disponível")

                </span>

            </div>

        </div>

    </section>

</div>