@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
}

<div class="screen product-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Produtos
            </span>

            <h1>
                Excluir produto
            </h1>

            <p>
                Confira o item antes de removê-lo
                do cadastro.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para produtos

        </a>

    </div>


    <section class="danger-panel">

        <div class="danger-top">

            <div class="danger-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M10.3 2.8 1.7 18a2 2 0 0 0 1.7 3h17.2a2 2 0 0 0 1.7-3L13.7 2.8a2 2 0 0 0-3.4 0Z" />

                    <path d="M12 9v4M12 17h.01" />

                </svg>

            </div>


            <div>

                <h2>
                    Esta ação é permanente
                </h2>

                <p>
                    Ao confirmar, o produto
                    <strong>@Model.Nome</strong>
                    será removido do sistema.
                </p>

            </div>

        </div>


        <div class="danger-body">

            <div class="delete-summary">

                <div class="delete-summary-item">

                    <span>Produto</span>

                    <strong>
                        @Model.Nome
                    </strong>

                </div>


                <div class="delete-summary-item">

                    <span>Preço</span>

                    <strong>

                        @Model.Preco.ToString(
                        "C",
                                                new System.Globalization.CultureInfo("pt-BR")
                                                )

                    </strong>

                </div>


                <div class="delete-summary-item">

                    <span>Estoque</span>

                    <strong>
                        @Model.Estoque unidade(s)
                    </strong>

                </div>

            </div>


            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="IdProduto" />


                <div class="form-actions">

                    <a asp-action="Index"
                       class="ui-btn ui-btn-light">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="ui-btn ui-btn-danger">

                        Confirmar exclusão

                    </button>

                </div>

            </form>

        </div>

    </section>

</div>