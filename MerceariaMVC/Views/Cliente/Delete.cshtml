@model MerceariaMVC.Models.Cliente

@{
    ViewData["Title"] = "Excluir cliente";
}

<div class="screen client-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Clientes
            </span>

            <h1>
                Excluir cliente
            </h1>

            <p>
                Revise os dados antes
                de confirmar a exclusão.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para clientes

        </a>

    </div>


    <section class="danger-panel">

        <div class="danger-top">

            <div class="danger-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M10.3 2.8 1.7 18a2 2 0 0 0 1.7 3h17.2a2 2 0 0 0 1.7-3L13.7 2.8a2 2 0 0 0-3.4 0Z" />

                    <path d="M12 9v4M12 17h.01" />

                </svg>

            </div>

            <div>

                <h2>
                    Esta ação é permanente
                </h2>

                <p>
                    Ao confirmar, o cadastro de
                    <strong>@Model.Nome</strong>
                    será removido do sistema.
                </p>

            </div>

        </div>


        <div class="danger-body">

            <div class="delete-summary">

                <div class="delete-summary-item">

                    <span>Nome</span>

                    <strong>
                        @Model.Nome
                    </strong>

                </div>


                <div class="delete-summary-item">

                    <span>E-mail</span>

                    <strong>
                        @Model.Email
                    </strong>

                </div>


                <div class="delete-summary-item">

                    <span>Idade</span>

                    <strong>
                        @Model.Idade anos
                    </strong>

                </div>

            </div>


            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="IdCliente" />


                <div class="form-actions">

                    <a asp-action="Index"
                       class="ui-btn ui-btn-light">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="ui-btn ui-btn-danger">

                        Confirmar exclusão

                    </button>

                </div>

            </form>

        </div>

    </section>

</div>