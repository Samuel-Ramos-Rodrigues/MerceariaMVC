@model MerceariaMVC.Models.Cliente

@{
    ViewData["Title"] = "Editar cliente";
}

<div class="screen client-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Clientes
            </span>

            <h1>Editar cliente</h1>

            <p>
                Atualize as informações de
                <strong>@Model.Nome</strong>.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para clientes

        </a>

    </div>


    <div class="form-layout">

        <aside class="form-aside">

            <div class="aside-accent"></div>

            <div class="aside-body">

                <div class="aside-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M12 20h9" />

                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />

                    </svg>

                </div>

                <h3>
                    Atualização de cadastro
                </h3>

                <p>
                    Faça as alterações necessárias
                    e salve para manter os dados consistentes.
                </p>


                <div class="aside-tips">

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            Revise nome e e-mail
                            antes de salvar.
                        </span>

                    </div>

                    <div class="aside-tip">

                        <span class="tip-dot"></span>

                        <span>
                            A situação pode ser alterada
                            a qualquer momento.
                        </span>

                    </div>

                </div>

            </div>

        </aside>


        <section class="form-panel">

            <div class="form-panel-header">

                <h2>Dados atuais</h2>

                <p>
                    Edite apenas o que precisar.
                </p>

            </div>


            <div class="form-panel-body">

                <form asp-action="Edit">

                    <input type="hidden"
                           asp-for="IdCliente" />


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="form-grid">

                        <div class="field-group form-span-2">

                            <label asp-for="Nome">
                                Nome completo
                            </label>

                            <input asp-for="Nome"
                                   class="form-control" />

                            <span asp-validation-for="Nome"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group">

                            <label asp-for="Email">
                                E-mail
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group">

                            <label asp-for="Idade">
                                Idade
                            </label>

                            <input asp-for="Idade"
                                   class="form-control"
                                   min="0" />

                            <span asp-validation-for="Idade"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="field-group form-span-2">

                            <label>
                                Situação do cliente
                            </label>


                            <div class="switch-panel">

                                <div class="switch-copy">

                                    <strong>
                                        Cliente ativo
                                    </strong>

                                    <small>
                                        Ative ou desative
                                        o cadastro deste cliente.
                                    </small>

                                </div>


                                <div class="form-check form-switch m-0">

                                    <input asp-for="Ativo"
                                           class="form-check-input"
                                           role="switch" />

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="form-actions">

                        <a asp-action="Index"
                           class="ui-btn ui-btn-light">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="ui-btn ui-btn-primary">

                            Salvar alterações

                        </button>

                    </div>

                </form>

            </div>

        </section>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}