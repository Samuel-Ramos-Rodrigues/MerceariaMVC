@model IEnumerable<MerceariaMVC.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="small text-muted mb-1">Cadastros</div>
            <h1 class="h3 mb-1">Clientes</h1>
            <p class="text-muted mb-0">Consulte e gerencie os clientes cadastrados na mercearia.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Início</a>
            <a asp-action="Create" class="btn btn-primary">Novo cliente</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <span class="fw-semibold">Lista de clientes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Nome</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Idade</th>
                            <th class="py-3">Status</th>
                            <th class="px-4 py-3 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 fw-semibold">@Html.DisplayFor(modelItem => item.Nome)</td>
                            <td class="text-muted">@Html.DisplayFor(modelItem => item.Email)</td>
                            <td>@Html.DisplayFor(modelItem => item.Idade)</td>
                            <td>
                                @if (item.Ativo)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inativo</span>
                                }
                            </td>
                            <td class="px-4 text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
