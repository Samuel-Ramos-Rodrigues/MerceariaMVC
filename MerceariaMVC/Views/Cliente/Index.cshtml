@model IEnumerable<MerceariaMVC.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";

    var totalClientes = Model?.Count() ?? 0;
    var ativos = Model?.Count(x => x.Ativo) ?? 0;
    var inativos = totalClientes - ativos;
}

<div class="screen client-theme">

    <div class="page-heading">

        <div>
            <span class="eyebrow">Cadastros</span>

            <h1>Clientes</h1>

            <p>
                Consulte, filtre e mantenha os dados
                dos clientes organizados.
            </p>
        </div>

        <a asp-action="Create"
           class="ui-btn ui-btn-primary">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <path d="M12 5v14M5 12h14" />

            </svg>

            Novo cliente
        </a>

    </div>


    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />

                </svg>

            </div>

            <div>
                <small>Total de clientes</small>
                <strong>@totalClientes</strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="m9 12 2 2 4-4" />
                    <circle cx="12" cy="12" r="9" />

                </svg>

            </div>

            <div>
                <small>Clientes ativos</small>
                <strong>@ativos</strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <circle cx="12" cy="12" r="9" />
                    <path d="M8 12h8" />

                </svg>

            </div>

            <div>
                <small>Clientes inativos</small>
                <strong>@inativos</strong>
            </div>

        </div>

    </div>


    <section class="data-panel">

        <div class="data-toolbar">

            <div class="toolbar-group">

                <div class="search-box">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.6-3.6" />

                    </svg>

                    <input id="clienteBusca"
                           type="search"
                           placeholder="Pesquisar por nome ou e-mail..."
                           autocomplete="off" />

                </div>

                <select id="clienteFiltro"
                        class="toolbar-select">

                    <option value="todos">
                        Todos os status
                    </option>

                    <option value="ativo">
                        Ativos
                    </option>

                    <option value="inativo">
                        Inativos
                    </option>

                </select>

            </div>

            <span id="clienteResultado"
                  class="result-count">

                @totalClientes registro(s)

            </span>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="modern-table"
                       id="clientesTabela">

                    <thead>

                        <tr>
                            <th>Cliente</th>
                            <th>E-mail</th>
                            <th>Idade</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var status =
                            item.Ativo ? "ativo" : "inativo";

                            var buscaCliente =
                            $"{item.Nome} {item.Email}"
                            .ToLowerInvariant();

                            <tr class="cliente-row"
                                data-search="@buscaCliente"
                                data-status="@status">

                                <td class="entity-mobile"
                                    data-label="Cliente">

                                    <div class="entity-cell">

                                        <span class="entity-avatar">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <circle cx="12" cy="8" r="4" />
                                                <path d="M4 21a8 8 0 0 1 16 0" />

                                            </svg>

                                        </span>

                                        <div>

                                            <strong>
                                                @item.Nome
                                            </strong>

                                            <small>
                                                Cliente #@item.IdCliente
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td data-label="E-mail">
                                    @item.Email
                                </td>

                                <td data-label="Idade">
                                    @item.Idade anos
                                </td>

                                <td data-label="Status">

                                    @if (item.Ativo)
                                    {
                                        <span class="status-pill status-ok">
                                            Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-muted">
                                            Inativo
                                        </span>
                                    }

                                </td>

                                <td data-label="Ações">

                                    <div class="row-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdCliente"
                                           class="row-action"
                                           title="Detalhes">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <circle cx="12"
                                                        cy="12"
                                                        r="3" />

                                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" />

                                            </svg>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdCliente"
                                           class="row-action"
                                           title="Editar">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />

                                            </svg>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdCliente"
                                           class="row-action delete"
                                           title="Excluir">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">

                                                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v5M14 11v5" />

                                            </svg>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div id="clienteSemResultado"
                 class="filter-empty-state">

                <h3>Nenhum cliente encontrado</h3>

                <p>
                    Tente outro termo de pesquisa
                    ou altere o filtro de status.
                </p>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21a8 8 0 0 1 16 0" />

                    </svg>

                </div>

                <h3>Nenhum cliente cadastrado</h3>

                <p>
                    Cadastre o primeiro cliente
                    para começar a organizar seus registros.
                </p>

                <a asp-action="Create"
                   class="ui-btn ui-btn-primary">

                    Cadastrar cliente

                </a>

            </div>
        }

    </section>

</div>


@section Scripts {

    <script>

        (() => {

            const busca =
                document.getElementById('clienteBusca');

            const filtro =
                document.getElementById('clienteFiltro');

            const rows =
                [...document.querySelectorAll('.cliente-row')];

            const contador =
                document.getElementById('clienteResultado');

            const vazio =
                document.getElementById('clienteSemResultado');

            const tabela =
                document.getElementById('clientesTabela');


            if (!busca || !filtro || !rows.length)
                return;


            const aplicar = () => {

                const termo =
                    busca.value.trim().toLowerCase();

                const status =
                    filtro.value;

                let visiveis = 0;


                rows.forEach(row => {

                    const combinaBusca =
                        !termo ||
                        row.dataset.search.includes(termo);

                    const combinaStatus =
                        status === 'todos' ||
                        row.dataset.status === status;

                    const mostrar =
                        combinaBusca && combinaStatus;


                    row.style.display =
                        mostrar ? '' : 'none';


                    if (mostrar)
                        visiveis++;

                });


                contador.textContent =
                    `${visiveis} registro(s)`;


                vazio.style.display =
                    visiveis === 0
                        ? 'block'
                        : 'none';


                tabela.style.display =
                    visiveis === 0
                        ? 'none'
                        : 'table';

            };


            busca.addEventListener(
                'input',
                aplicar
            );


            filtro.addEventListener(
                'change',
                aplicar
            );

        })();

    </script>

}