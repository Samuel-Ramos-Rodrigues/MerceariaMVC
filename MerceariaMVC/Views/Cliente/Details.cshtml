@model MerceariaMVC.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do cliente";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="small text-muted mb-1">Clientes</div>
            <h1 class="h3 mb-1">Detalhes do cliente</h1>
            <p class="text-muted mb-0">Informações do cadastro selecionado.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para clientes</a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@Html.DisplayFor(model => model.Nome)</span>
                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border">Inativo</span>
                    }
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Nome</div>
                            <div class="fw-semibold">@Html.DisplayFor(model => model.Nome)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Email</div>
                            <div class="fw-semibold">@Html.DisplayFor(model => model.Email)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Idade</div>
                            <div class="fw-semibold">@Html.DisplayFor(model => model.Idade)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Status</div>
                            <div class="fw-semibold">@(Model.Ativo ? "Cliente ativo" : "Cliente inativo")</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Edit" asp-route-id="@Model?.IdCliente" class="btn btn-primary">Editar cliente</a>
                        <a asp-action="Delete" asp-route-id="@Model?.IdCliente" class="btn btn-outline-danger">Excluir</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
