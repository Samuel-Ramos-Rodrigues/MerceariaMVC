@model MerceariaMVC.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do cliente";
}

<div class="screen client-theme">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                Clientes
            </span>

            <h1>
                Detalhes do cliente
            </h1>

            <p>
                Visualize todas as informações
                do cadastro selecionado.
            </p>

        </div>

        <a asp-action="Index"
           class="ui-btn ui-btn-light">

            ← Voltar para clientes

        </a>

    </div>


    <section class="detail-hero">

        <div class="detail-identity">

            <div class="detail-avatar">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <circle cx="12"
                            cy="8"
                            r="4" />

                    <path d="M4 21a8 8 0 0 1 16 0" />

                </svg>

            </div>

            <div>

                <h2>
                    @Model.Nome
                </h2>

                <p>
                    Cliente #@Model.IdCliente · @Model.Email
                </p>

            </div>

        </div>


        <div class="detail-hero-actions">

            @if (Model.Ativo)
            {
                <span class="status-pill status-ok">
                    Ativo
                </span>
            }
            else
            {
                <span class="status-pill status-muted">
                    Inativo
                </span>
            }


            <a asp-action="Edit"
               asp-route-id="@Model.IdCliente"
               class="ui-btn ui-btn-primary">

                Editar cliente

            </a>

        </div>

    </section>


    <section class="detail-panel">

        <div class="detail-panel-header">
            Informações do cadastro
        </div>


        <div class="detail-grid">

            <div class="detail-field">

                <span class="detail-label">
                    Nome
                </span>

                <span class="detail-value">
                    @Model.Nome
                </span>

            </div>


            <div class="detail-field">

                <span class="detail-label">
                    E-mail
                </span>

                <span class="detail-value">
                    @Model.Email
                </span>

            </div>


            <div class="detail-field">

                <span class="detail-label">
                    Idade
                </span>

                <span class="detail-value">
                    @Model.Idade anos
                </span>

            </div>


            <div class="detail-field">

                <span class="detail-label">
                    Situação
                </span>

                <span class="detail-value">
                    @(Model.Ativo ? "Ativo" : "Inativo")
                </span>

            </div>

        </div>

    </section>

</div>